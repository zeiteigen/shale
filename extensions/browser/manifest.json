{
  "name": "browser",
  "version": "0.3.0",
  "description": "Ingests and analyzes browser activity: active web pages, history, bookmarks, and explicit session groupings with LLM graph enrichment.",
  "namespace": "browser",
  "subscribe_ingest": "subscribe.ts",
  "checkpoint_recover": "recover.ts",
  "chrome_module": {
    "background": "chrome/background.js",
    "popup": "chrome/popup.js",
    "inject": { "extract": "chrome/inject/extract.ts" }
  },
  "crons": [
    {
      "name": "browser-session-aggregator",
      "script": "index.ts",
      "schedule": "* * * * *",
      "run_on_startup": true
    }
  ]
}
