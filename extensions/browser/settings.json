{
  "excludeDomains": [
    "x.com",
    "twitter.com",
    "reddit.com",
    "facebook.com",
    "instagram.com",
    "tiktok.com",
    "linkedin.com",
    "youtube.com",
    "localhost"
  ],
  "excludePatterns": [
    "*localhost:7425*",
    "*mail.google.com*",
    "*accounts.google.com*",
    "*bank*",
    "*login*",
    "*signin*",
    "*duosecurity.com*",
    "*/oauth/*",
    "*/oidc/*",
    "*adfs/ls*"
  ],
  "excludePrivateBrowsing": true,
  "sessionInactivityMinutes": 30,
  "enableLlmAnalysis": false,
  "generateSessionSummaries": true,
  "extractTopics": true,
  "minContentLength": 100,
  "maxContentChars": 3000,
  "chunkSize": 1000,
  "llmModel": null,
  "namespace": "browser",
  "enableImageAnalysis": false,
  "refineResearchContexts": false,
  "retainRemovedCatalogEvidence": true,
  "maxPendingJobs": 5000,
  "maxPendingBytes": 50000000,
  "maxJobsPerRun": 20,
  "maxBatchBytes": 1000000,
  "maxJobAttempts": 5,
  "maxSessionsPerRun": 3,
  "maxSessionEvents": 200,
  "collectionWindowMs": 3000,
  "fetchHistoryPages": true,
  "allowPublicPageEnrichment": false,
  "maxPublicPagesPerRun": 2
}
