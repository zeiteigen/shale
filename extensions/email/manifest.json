{
  "name": "email",
  "namespace": "email",
  "version": "0.1.0",
  "description": "Ingest email conversations from recursive .eml/.mbox imports and read-only IMAP sync over TLS.",
  "checkpoint_recover": "recover.ts",
  "setup_script": "refresh.ts",
  "auth_script": "auth.ts",
  "install_script": "install.ts",
  "crons": [
    { "name": "email-import", "schedule": "*/15 * * * *", "script": "index.ts", "run_on_startup": true },
    { "name": "email-sync", "schedule": "0 * * * *", "script": "sync.ts" }
  ]
}
