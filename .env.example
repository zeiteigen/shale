# OpenAI-compatible Embedding Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Alternatively, specify the full endpoint URL:
# OPENAI_ENDPOINT=https://api.openai.com/v1/embeddings

# Embedding model name
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat model name
OPENAI_CHAT_MODEL=gpt-4o-mini

# Timeout Configuration (milliseconds):
# Automatically defaults to 300,000ms (5 mins) when OPENAI_BASE_URL points to localhost/127.0.0.1
# so that local model servers (vLLM, Ollama, llama.cpp) have ample time to load model weights into VRAM on first request.
# Defaults to 60,000ms (1 min) for cloud endpoints.
# MODEL_TIMEOUT_MS=300000

# Reasoning & Thinking Tokens Configuration:
# Defaults to "low" reasoning effort and 512 max thinking tokens at the SSDK level.
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_THINKING_TOKENS=512

# Vector dimensions (defaults to 4096 to match SQLite vec0 float[4096] virtual table)
EMBEDDING_DIMENSIONS=4096

