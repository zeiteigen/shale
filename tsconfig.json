{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["bun"],
    "paths": {
      "@shale/sdk": ["./sdk/index.ts"],
      "@shale/sdk/*": ["./sdk/*"]
    }
  },
  "include": ["lib/**/*.ts", "sdk/**/*.ts", "main/**/*.ts", "extensions/**/*.ts", "scripts/*.ts", "visualizer/server.ts", "visualizer/graph-data.ts"]
}
